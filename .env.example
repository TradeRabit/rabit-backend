# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# OpenRouter (optional - if you want to use OpenRouter instead of Anthropic)
# Set USE_OPENROUTER=true to enable OpenRouter
USE_OPENROUTER=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Available models: anthropic/claude-3.5-sonnet, anthropic/claude-3-opus, etc.
# See: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Drift Protocol
DRIFT_RPC_URL=https://api.mainnet-beta.solana.com
DRIFT_PROGRAM_ID=dRiftyHA39MWEi3m9aunc5MzRF1JYJjb5ciH7N27eNn

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8000

# Trading Assets (used by all WebSocket sources: Drift, Binance, etc.)
# Format: Symbol without -PERP suffix
TRADING_ASSETS=BTC,ETH,SOL,DOGE,BNB,SUI,APT,ARB,RENDER,XRP,INJ,LINK,PYTH,JTO,AVAX,WIF,JUP,TAO,KMNO,TNSR,DRIFT,RAY,HYPE,LTC,FARTCOIN

# Drift WebSocket
DRIFT_WS_URL=wss://drift-mainnet.rpc.drift.trade
DRIFT_SUBSCRIBE_ASSETS=25
# Note: Drift will use TRADING_ASSETS automatically

# Binance Configuration
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_OHLC_INTERVAL=1h
BINANCE_OHLC_DOWNLOAD_LIMIT=100

# Data Configuration
WS_DATA_FIELDS=price,change_24h,volume_24h,open_interest,funding_rate
OHLC_ENABLED=true
OHLC_HISTORY_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=true


# Mem0 Configuration
MEM0_ENABLED=true
MEM0_HOST=localhost
MEM0_PORT=8080

# SearXNG Configuration
SEARXNG_ENABLED=true
SEARXNG_URL=http://localhost:8888
