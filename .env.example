# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# OpenRouter (optional - if you want to use OpenRouter instead of Anthropic)
# Set USE_OPENROUTER=true to enable OpenRouter
USE_OPENROUTER=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Available models: anthropic/claude-3.5-sonnet, anthropic/claude-3-opus, etc.
# See: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SESSION_COST_DB_PATH=data/openrouter_session_costs.json

# Drift Protocol
DRIFT_RPC_URL=https://api.mainnet-beta.solana.com
DRIFT_PROGRAM_ID=dRiftyHA39MWEi3m9aunc5MzRF1JYJjb5ciH7N27eNn
DRIFT_EXECUTION_ENABLED=false
DRIFT_EXECUTION_REQUESTS_DB_PATH=data/drift_execution_requests.json
DRIFT_EXECUTION_PREPARE_TTL_SECONDS=900

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8000

# Trading Assets (used by all WebSocket sources: Drift, Binance, etc.)
# Format: Symbol without -PERP suffix
TRADING_ASSETS=BTC,ETH,SOL,DOGE,BNB,SUI,APT,ARB,RENDER,XRP,INJ,LINK,PYTH,JTO,AVAX,WIF,JUP,TAO,KMNO,TNSR,DRIFT,RAY,HYPE,LTC,FARTCOIN

# Drift WebSocket
DRIFT_WS_URL=wss://data.api.drift.trade/ws
DRIFT_DLOB_WS_URL=wss://dlob.drift.trade/ws
DRIFT_SUBSCRIBE_ASSETS=25
# Note: Drift will use TRADING_ASSETS automatically

# Backpack Exchange
BACKPACK_API_URL=https://api.backpack.exchange
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_WS_URL=wss://ws.backpack.exchange
BACKPACK_ENABLED=true
BACKPACK_EXECUTION_ENABLED=false
BACKPACK_QUOTE_ASSET=USDC
BACKPACK_SUBSCRIBE_ASSETS=25

# Price Source Selection
# Options: "drift", "backpack", or "both"
PRICE_SOURCE=both

# Binance Configuration
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_OHLC_INTERVAL=1h
BINANCE_OHLC_DOWNLOAD_LIMIT=100

# Data Configuration
WS_DATA_FIELDS=price,change_24h,volume_24h,open_interest,funding_rate
OHLC_ENABLED=true
OHLC_HISTORY_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=false


# Mem0 Configuration
MEM0_ENABLED=false
MEMORY_TOOLS_ENABLED=true
MEM0_HOST=localhost
MEM0_PORT=8080
MEM0_URL=http://localhost:8080
MEM0_INTERNAL_URL=http://mem0:8000
MEM0_API_KEY=

# Mem0 server dependency (used by self-hosted mem0-api-server defaults)
OPENAI_API_KEY=

# Agent pipeline artifacts
AGENT_PIPELINE_ARTIFACTS_DB_PATH=data/agent_pipeline_artifacts.json
AGENT_PIPELINE_ARTIFACT_TTL_SECONDS=604800

# Tool feature gates
WEB_SEARCH_ENABLED=true
NEWS_IS_NEW_WINDOW_SECONDS=86400

# Exchange connection storage
# Generate a 32-byte random key and encode it as base64 for multi-user exchange credential encryption.
EXCHANGE_CONNECTIONS_DB_PATH=data/exchange_connections.json
EXCHANGE_CREDENTIALS_MASTER_KEY=
TRADE_DEBRIEF_DB_PATH=data/trade_debriefs.json

# Mobile wallet auth
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=rabit-backend
AUTH_JWT_AUDIENCE=rabit-mobile
AUTH_JWT_TTL_SECONDS=604800
WALLET_AUTH_NONCE_DB_PATH=data/wallet_auth_nonces.json
WALLET_AUTH_NONCE_TTL_SECONDS=300

# SearXNG Configuration
SEARXNG_ENABLED=true
SEARXNG_URL=http://localhost:8888
