# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# OpenRouter (optional - if you want to use OpenRouter instead of Anthropic)
# Set USE_OPENROUTER=true to enable OpenRouter
USE_OPENROUTER=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Available models: anthropic/claude-3.5-sonnet, anthropic/claude-3-opus, etc.
# See: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SESSION_COST_DB_PATH=data/openrouter_session_costs.json
MONITORING_COST_DB_PATH=data/monitoring_costs.json
ALERT_SETUP_COST_USD=0.001
MONITORING_COST_PER_SYMBOL_HOUR_USD=0.002
ALERT_TRIGGER_COST_USD=0.0005

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8000

# Trading Assets used by the Phantom market surface backed by Hyperliquid
TRADING_ASSETS=BTC,ETH,SOL,DOGE,BNB,SUI,APT,ARB,RENDER,XRP,INJ,LINK,PYTH,JTO,AVAX,WIF,JUP,TAO,KMNO,TNSR,DRIFT,RAY,HYPE,LTC,FARTCOIN

# Phantom / Hyperliquid market data
PHANTOM_ENABLED=true
PHANTOM_PRICE_POLL_INTERVAL_SECONDS=5
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_DEX=

# Price Source Selection
PRICE_SOURCE=phantom

# Binance Configuration

# Data Configuration
WS_DATA_FIELDS=price,change_24h,volume_24h,open_interest,funding_rate
OHLC_ENABLED=true
OHLC_HISTORY_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=false


# Mem0 Configuration
MEM0_ENABLED=false
MEMORY_TOOLS_ENABLED=true
MEM0_HOST=localhost
MEM0_PORT=8080
MEM0_URL=http://localhost:8080
MEM0_INTERNAL_URL=http://mem0:8000
MEM0_API_KEY=

# Mem0 server dependency (used by self-hosted mem0-api-server defaults)
OPENAI_API_KEY=

# Agent pipeline artifacts
AGENT_PIPELINE_ARTIFACTS_DB_PATH=data/agent_pipeline_artifacts.json
AGENT_PIPELINE_ARTIFACT_TTL_SECONDS=604800

# Tool feature gates
WEB_SEARCH_ENABLED=true
NEWS_IS_NEW_WINDOW_SECONDS=86400

# Exchange connection storage
# Generate a 32-byte random key and encode it as base64 for multi-user exchange credential encryption.
EXCHANGE_CONNECTIONS_DB_PATH=data/exchange_connections.json
EXCHANGE_CREDENTIALS_MASTER_KEY=
TRADE_DEBRIEF_DB_PATH=data/trade_debriefs.json

# Rabit on-chain contract
RABIT_CONTRACT_CLUSTER=devnet
RABIT_CONTRACT_RPC_URL=
RABIT_CONTRACT_PROGRAM_ID=
RABIT_AI_USAGE_PAYMENT_MINT=
RABIT_AI_USAGE_PAYMENT_TOKEN_SYMBOL=USDC
RABIT_AI_USAGE_PAYMENT_MINT_DECIMALS=6
RABIT_AI_USAGE_PAYMENT_TOKEN_USD_PRICE=1.0
RABIT_AI_USAGE_PLATFORM_FEE_BPS=500
RABIT_AI_USAGE_DEFAULT_MARKUP_BPS=500
RABIT_AI_USAGE_DEFAULT_USAGE_TYPE=text
RABIT_AI_USAGE_CHAT_MIN_BALANCE_USD=1.0
RABIT_AI_USAGE_ENFORCE_CHAT_BALANCE=true
RABIT_AI_USAGE_DELEGATION_EXPIRY_SECONDS=2592000
RABIT_AI_USAGE_DELEGATION_SPENDING_LIMIT_UNITS=1000000000
RABIT_CONTRACT_BACKEND_SIGNER=
RABIT_AI_USAGE_SETTLEMENTS_DB_PATH=data/ai_usage_settlements.json

# Mobile wallet auth
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=rabit-backend
AUTH_JWT_AUDIENCE=rabit-mobile
AUTH_JWT_TTL_SECONDS=604800
WALLET_AUTH_NONCE_DB_PATH=data/wallet_auth_nonces.json
WALLET_AUTH_NONCE_TTL_SECONDS=300

# SearXNG Configuration
SEARXNG_ENABLED=true
SEARXNG_URL=http://localhost:8888
